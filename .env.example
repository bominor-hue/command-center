# The farm hub's Supabase project (its own project, not Pivot Log's). Leave blank to run the wall on sample data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Link the WATER panel opens (the Pivot Log site).
VITE_PIVOT_LOG_URL=
# The 4-digit PIN that turns Visitor mode back off on this screen.
VITE_VISITOR_PIN=
# Wall palette: pine (default), graphite, porch or cream. ?theme= on the URL overrides it on one screen.
VITE_THEME=
